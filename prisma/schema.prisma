// Anorix dashboard: mirror of the LIVE database (introspected with `prisma db pull`, Oct 2026).
// Shared with the anorent main site. Do NOT run `prisma db push` / `migrate` from this repo:
// the dashboard only reads/writes DeploymentProduct and User. Change the database deliberately, never by schema sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteConfig {
  id              String    @id @default("singleton")
  brandName       String    @default("Anorix Studio")
  brandLogoText   String?   @default("ANORIX")
  brandTagline    String?   @default("Digital Artist & Creative Technologist Studio")
  liveBadgeStatus String    @default("99.98% LIVE")
  pingLatency     String?   @default("4ms")
  escrowCoverage  String?   @default("100% ESCROW-PROTECTED")
  contactEmail    String    @default("ahsxn3d@gmail.com")
  telegramHandle  String?   @default("@anorix")
  discordHandle   String?   @default("anorix#0001")
  githubUrl       String?   @default("https://github.com/anorix")
  twitterUrl      String?   @default("https://twitter.com/anorix")
  metaTitle       String    @default("Anorix | Digital Craft Studio & SaaS Hub")
  metaDescription String?   @default("Bespoke web applications, 3D WebGL experiences, and proprietary SaaS platforms.")
  createdAt       DateTime? @default(now())
  updatedAt       DateTime  @updatedAt
  whatsappNumber  String    @default("+923284992759")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  companyName   String?
  emailVerified DateTime?
  image         String?
  status        UserStatus     @default(NEW_SIGNUP)
  totalSpendUsd Int            @default(0)
  role          UserRole       @default(CLIENT)
  ClientOrder   ClientOrder[]
  Subscription  Subscription[]
}

model DeploymentProduct {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  client           String?
  year             String?       @default("2026")
  category         String        @default("Web Applications")
  badge            String?
  shortDescription String
  fullDescription  String?
  thumbnailUrl     String
  coverImageUrl    String?
  previewVideoUrl  String?
  demoUrl          String        @default("#")
  githubUrl        String?
  liveUrl          String        @default("#")
  rating           Float         @default(5.0)
  tags             String[]
  techStack        String[]
  features         String[]
  fpsBenchmark     Int           @default(60)
  auditScore       Int           @default(100)
  isFeatured       Boolean       @default(false)
  isPublished      Boolean       @default(true)
  displayOrder     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appLaunchUrl     String?
  type             ProductType   @default(STUDIO_SERVICE)
  status           ProductStatus @default(PRODUCTION)
}

model ReviewItem {
  id         String   @id @default(cuid())
  name       String
  role       String?
  company    String?
  avatarUrl  String?
  comment    String
  rating     Int      @default(5)
  dateString String?
  tags       String[] @default([])
  isVerified Boolean  @default(true)
  isApproved Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactSubmission {
  id            String   @id @default(cuid())
  name          String
  email         String
  company       String?
  projectType   String?
  budget        String?
  timeline      String?
  message       String
  status        String   @default("NEW")
  priority      String   @default("NORMAL")
  notes         String?
  internalNotes String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FaqHeaderConfig {
  id                String   @id @default("singleton")
  badgeText         String   @default("[ CLEAR ANSWERS // ZERO AMBIGUITY ]")
  pageTitle         String   @default("FREQUENTLY ASKED QUESTIONS")
  pageSubtitle      String   @default("Straight talk on pricing, escrow milestones, WebGL performance, and production handoff.")
  searchPlaceholder String   @default("Search escrow, stack, timelines, pricing...")
  supportEmail      String   @default("hello@anorix.com")
  telemetry1Title   String   @default("ESCROW PROTECTED")
  telemetry1Sub     String   @default("100% Milestone-gated")
  telemetry2Title   String   @default("PERFORMANCE SLA")
  telemetry2Sub     String   @default("60 FPS WebGL Target")
  telemetry3Title   String   @default("IP TRANSFERRED")
  telemetry3Sub     String   @default("Full Commercial License")
  telemetry4Title   String   @default("RESPONSE TIME")
  telemetry4Sub     String   @default("< 4h Direct Comm")
  categories        String[] @default(["ALL", "PRICING & ESCROW", "TECH & SHADERS", "DELIVERY TIMELINE", "SUPPORT & SLA"])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FAQItem {
  id           String   @id @default(cuid())
  category     String
  question     String
  answer       String
  helpfulCount Int      @default(0)
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProofMetricCard {
  id           String   @id @default(cuid())
  cardKey      String   @unique
  title        String
  value        String
  subtext      String?
  percentage   Float?
  slaTarget    String?
  displayOrder Int      @default(0)
  metricsJson  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroContent {
  id                  String   @id @default("singleton")
  badgeText           String   @default("[ SOLO CREATIVE DEVELOPER & 3D ARTIST ]")
  superTitle          String?
  headlineLine1       String   @default("CYBERNETiC CRAFT")
  headlineLine2       String   @default("DiGiTAL REALMS")
  headlineLine3       String   @default("ENGiNEERED.")
  mainHeading         String?
  mainTitle           String?
  highlightedWord     String?  @default("CRAFT")
  bioSubtext          String
  subheading          String?
  subtitle            String?
  highlightWords      String[] @default([])
  primaryCtaLabel     String   @default("START A PROJECT Γåù")
  primaryCtaText      String?
  primaryCtaRoute     String   @default("contact")
  primaryCtaUrl       String?
  secondaryCtaLabel   String   @default("BROWSE DEPLOYMENTS")
  secondaryCtaText    String?
  secondaryCtaRoute   String   @default("deployments")
  secondaryCtaUrl     String?
  telemetryStatus     String   @default("ONLINE")
  telemetryLatency    String   @default("4ms")
  telemetryUptime     String   @default("99.98%")
  pricingNoticeText   String   @default("Custom builds starting at $1,000 // Fast turnaround")
  particleModes       String[] @default(["quantum", "orbital", "matrix"])
  defaultParticleMode String   @default("quantum")
  baseNodeCount       Int      @default(100)
  targetFps           Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model StoryStage {
  id            String             @id @default(cuid())
  stageIndex    Int                @unique
  phase         String?
  year          String?
  title         String?
  subtitle      String?
  description   String
  highlightTag  String?
  stageBadge    String?
  headlineLine1 String?
  headlineLine2 String?
  specTag1Title String?
  specTag1Sub   String?
  specTag2Title String?
  specTag2Sub   String?
  specTag3Title String?
  specTag3Sub   String?
  bulletPoint1  String?
  bulletPoint2  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  nodes         ArchitectureNode[]
  phases        EscrowPhase[]
}

model ArchitectureNode {
  id        String      @id @default(cuid())
  stageId   String?
  key       String
  name      String
  latency   String
  summary   String
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  stage     StoryStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model EscrowPhase {
  id                   String      @id @default(cuid())
  stageId              String?
  phaseNumber          Int
  title                String
  description          String
  verificationCriteria String?
  status               String      @default("PENDING")
  allocationPercentage Int         @default(25)
  badgeText            String?
  createdAt            DateTime    @default(now())
  stage                StoryStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model AboutContent {
  id                   String   @id @default("singleton")
  name                 String   @default("Anorix")
  artistName           String?  @default("Ahsan")
  role                 String   @default("Lead Creative Technologist & Full-Stack Architect")
  tagline              String?  @default("Solo Creative Developer & 3D Artist")
  handle               String?  @default("ahsxn.3d")
  avatarUrl            String?  @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80")
  executiveBio         String
  bio                  String?
  location             String   @default("Lahore, PK (UTC+5)")
  locationTimezone     String   @default("UTC+5 Active")
  availabilityStatus   String   @default("AVAILABLE FOR Q3/Q4 COMMISSIONS")
  yearsActive          String   @default("3+ Years")
  deploymentsDelivered String   @default("12+")
  clientSatisfaction   String   @default("100%")
  techSkills           String[] @default([])
  contactEmail         String   @default("ahsxn3d@gmail.com")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ClientOrder {
  id                 String               @id
  orderNumber        String               @unique
  userId             String?
  clientName         String
  clientEmail        String
  companyName        String?
  packageId          String?
  couponId           String?
  totalAmountUsd     Int
  depositAmountUsd   Int
  status             OrderStatus          @default(NEW_INQUIRY)
  stagingUrl         String?
  productionUrl      String?
  githubRepoUrl      String?
  adminNotes         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  DiscountCoupon     DiscountCoupon?      @relation(fields: [couponId], references: [id])
  PricingPackage     PricingPackage?      @relation(fields: [packageId], references: [id])
  User               User?                @relation(fields: [userId], references: [id])
  PaymentTransaction PaymentTransaction[]
  ProjectMilestone   ProjectMilestone[]
}

model DiscountCoupon {
  id             String        @id
  code           String        @unique
  description    String?
  discountType   DiscountType  @default(PERCENTAGE)
  discountValue  Int
  minOrderUsd    Int           @default(0)
  maxRedemptions Int?
  timesRedeemed  Int           @default(0)
  expiresAt      DateTime?
  isActive       Boolean       @default(true)
  showInPopUp    Boolean       @default(false)
  popUpMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  ClientOrder    ClientOrder[]
}

model PaymentTransaction {
  id             String          @id
  orderId        String
  provider       PaymentProvider @default(STRIPE)
  transactionRef String?
  amountUsd      Int
  isDeposit      Boolean         @default(true)
  status         String          @default("COMPLETED")
  paidAt         DateTime        @default(now())
  ClientOrder    ClientOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PricingPackage {
  id              String         @id
  slug            String         @unique
  tierName        String
  tagline         String
  basePriceUsd    Int
  isRecurring     Boolean        @default(false)
  billingInterval String?
  turnaroundDays  Int            @default(7)
  revisionsCount  Int            @default(3)
  isPopular       Boolean        @default(false)
  features        String[]
  deliverables    String[]
  techStack       String[]
  displayOrder    Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  ClientOrder     ClientOrder[]
  Subscription    Subscription[]
}

model ProjectMilestone {
  id          String      @id
  orderId     String
  title       String
  description String?
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  orderIndex  Int         @default(0)
  ClientOrder ClientOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String         @id
  userId               String
  packageId            String
  stripeSubscriptionId String?        @unique
  status               String         @default("ACTIVE")
  currentPeriodStart   DateTime       @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime
  PricingPackage       PricingPackage @relation(fields: [packageId], references: [id])
  User                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  NEW_INQUIRY
  DEPOSIT_PENDING
  IN_DEVELOPMENT
  REVIEW_STAGING
  UNDER_CONSTRUCTION
  FINAL_PAYMENT_PENDING
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  SOLANA_USDC
  ESCROW_FIVERR
  BANK_WIRE
}

enum ProductStatus {
  PRODUCTION
  BETA
  STAGING
  UNDER_CONSTRUCTION
  ARCHIVED
}

enum ProductType {
  STUDIO_SERVICE
  SAAS_PLATFORM
  AI_AGENT_TOOL
  DEVELOPER_UTILITY
}

enum UserRole {
  CLIENT
  SUBSCRIBER
  ADMIN
}

enum UserStatus {
  NEW_SIGNUP
  ACTIVE_CLIENT
  RECURRING_SUBSCRIBER
  INACTIVE
}


